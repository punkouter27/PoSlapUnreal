        "push_force_n": [150.0, 300.0],
        "push_duration_s": [0.1, 0.2],
        "graduation_gate": {
          "consecutive_episodes": 100,
          "min_no_fall_rate": 0.95,
          "min_in_box_rate": 0.95,
          "min_mean_return": 2400.0,
          "zero_nan_gradients": true
        }
      },
      "Stage_2_Steady_Natural_Walk": {
        "maps_to_level": "L1_Walk",
        "goal": "Take steady, natural alternating heel-to-toe steps and walk at a comfortable pace (1.0-1.4 m/s) with calm upper body and zero leg dragging.",
        "target_speed_m_s": [1.0, 1.4],
        "stride_frequency_hz": 1.8,
        "min_swing_foot_clearance_m": 0.06,
        "graduation_gate": {
          "consecutive_episodes": 100,
          "min_no_fall_rate": 0.95,
          "max_speed_tracking_error_m_s": 0.15,
          "min_stride_symmetry": 0.90,
          "zero_nan_gradients": true
        }
      },
      "Stage_3_Jog_Turn_Stop_And_Slopes": {
        "maps_to_level": "L1_Agile",
        "goal": "Jog (2.5-3.5 m/s), execute smooth yaw turns, stop smoothly into planted guard stance, and handle uneven terrain or slight slopes (+/- 5 to 8 deg).",
        "target_speed_m_s": [0.0, 3.5],
        "yaw_turn_rate_rad_s": [-1.5, 1.5],
        "terrain_slope_deg": [-8.0, 8.0],
        "terrain_heightfield_amplitude_m": 0.03,
        "graduation_gate": {
          "consecutive_episodes": 100,
          "min_no_fall_rate": 0.92,
          "smooth_stop_com_settled_m": 0.05,
          "zero_nan_gradients": true
        }
      }
    },
    "arena_combat_skill_ladder": {
