# Unreal
Binaries/
Intermediate/
Saved/
DerivedDataCache/
# Generated by UAT on every Android package (Java sources + cooker logs)
Build/
.vs/
*.sln
*.slnx
# Plugins build output (URLab lives in Plugins/ later)
Plugins/*/Binaries/
Plugins/*/Intermediate/
# Tools / local
.aura/
__pycache__/
*.pyc
.venv/
training/runs/
training/checkpoints/
training/logs/

# URLab clone (local commits saved in Plugins/urlab_poslap.patch)
Plugins/UnrealRoboticsLab/
training/replays/
Scripts/__pycache__/
Logs/

# Blender backups; FBX importers re-extract embedded textures
*.blend1
Content/Art/Exports/Kim_rigged.fbm/

# Training scratch: a night driver's symlink farm over training/ (it runs a long job against its own
# runs/ so the main runs are untouched) and the throwaway probes. Never commit these.
training_night/
training/_probe/
training/_scratch_*.py

# MuJoCo warning log (written next to whatever script ran)
MUJOCO_LOG.TXT

# URLab writes unused per-import material instances on every arena import
Content/MuJoCoImports/
