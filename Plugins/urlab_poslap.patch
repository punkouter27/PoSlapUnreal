+struct CoACD_MeshArray { CoACD_Mesh* meshes_ptr; uint64_t meshes_count; };
+
+constexpr int preprocess_auto = 0;
+constexpr int apx_ch = 0;
+
+inline void CoACD_freeMeshArray(CoACD_MeshArray) {}
+inline CoACD_MeshArray CoACD_run(CoACD_Mesh const&, double, int, int, int, int, int, int, int, bool, bool, bool, int,
+	bool, double, int, unsigned int, bool) { return { nullptr, 0 }; }
