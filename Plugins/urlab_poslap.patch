@@ -226,6 +236,34 @@ public class URLab : ModuleRules
 				}
 			}
 		}
+		else if (Target.Platform == UnrealTargetPlatform.Android)
+		{
+			string Arch = "arm64-v8a";
+			string LibPath = Path.Combine(FullPath, "lib", "Android", Arch);
+			if (!Directory.Exists(LibPath))
+			{
+				LibPath = Path.Combine(FullPath, "lib", Arch);
+			}
+			if (!Directory.Exists(LibPath))
+			{
+				LibPath = Path.Combine(FullPath, "lib");
+			}
+			if (Directory.Exists(LibPath))
