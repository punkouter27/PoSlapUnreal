From 14373b8981961f5a52e5d7c457f6f26cd094f84c Mon Sep 17 00:00:00 2001
From: PoSlap <punkouter26@gmail.com>
Date: Wed, 21 Oct 2026 14:50:39 -0400
Subject: [PATCH 2/3] UE 5.8: JSON object keys are FSharedString

---
 .../URLab/Private/Bridge/MsgpackHelpers.cpp   |  2 +-
 Source/URLab/Private/Bridge/RpcDispatcher.cpp | 22 +++++++++----------
 2 files changed, 12 insertions(+), 12 deletions(-)

diff --git a/Source/URLab/Private/Bridge/MsgpackHelpers.cpp b/Source/URLab/Private/Bridge/MsgpackHelpers.cpp
index 117dbd5..1573cdc 100644
--- a/Source/URLab/Private/Bridge/MsgpackHelpers.cpp
+++ b/Source/URLab/Private/Bridge/MsgpackHelpers.cpp
@@ -73,7 +73,7 @@ void PackJsonObjectInner(clmdep_msgpack::packer<Stream>& Packer,
 	Packer.pack_map(Obj->Values.Num());
 	for (const auto& Kv : Obj->Values)
 	{
-		const FString& Key = Kv.Key;
+		const FString Key(*Kv.Key);  // UE 5.8: JSON keys are FSharedString
 		// Special-case keys with kBinSuffix: emit real msgpack bin rather
 		// than the base64-as-string form the JSON tree carries.
 		if (Key.EndsWith(kBinSuffix, ESearchCase::CaseSensitive))
diff --git a/Source/URLab/Private/Bridge/RpcDispatcher.cpp b/Source/URLab/Private/Bridge/RpcDispatcher.cpp
index 9758d6f..2f812b9 100644
--- a/Source/URLab/Private/Bridge/RpcDispatcher.cpp
+++ b/Source/URLab/Private/Bridge/RpcDispatcher.cpp
@@ -994,12 +994,12 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 
 				FString CtlMode;
 				if ((*ArtObj)->TryGetStringField(TEXT("control_mode"), CtlMode))
-					TmpReq.PerArticulationControlMode.Add(Pair.Key, CtlMode);
+					TmpReq.PerArticulationControlMode.Add(FString(*Pair.Key), CtlMode);
 
 				const TArray<TSharedPtr<FJsonValue>>* CtrlList = nullptr;
 				if ((*ArtObj)->TryGetArrayField(TEXT("ctrl"), CtrlList) && CtrlList)
 				{
-					if (AMjArticulation* Art = Cast<AMjArticulation>(Mgr->GetArticulation(Pair.Key)))
+					if (AMjArticulation* Art = Cast<AMjArticulation>(Mgr->GetArticulation(FString(*Pair.Key))))
 					{
 						TArray<UMjActuator*> Acts = Art->GetActuators();
 						for (int32 i = 0; i < CtrlList->Num() && i < Acts.Num(); ++i)
@@ -1011,7 +1011,7 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 							FString Prefix = Art->GetName() + TEXT("_");
 							if (Local.StartsWith(Prefix))
 								Local = Local.Mid(Prefix.Len());
-							TmpReq.PerArticulationCtrl.FindOrAdd(Pair.Key).Add(
+							TmpReq.PerArticulationCtrl.FindOrAdd(FString(*Pair.Key)).Add(
 								{Local, (float)(*CtrlList)[i]->AsNumber()});
 						}
 					}
@@ -1066,7 +1066,7 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 					ECameraInclude E = ECameraInclude::Latest;
 					if (Mode.Equals(TEXT("sync"), ESearchCase::IgnoreCase))
 						E = ECameraInclude::Sync;
-					CameraSpec.Add(Kv.Key, E);
+					CameraSpec.Add(FString(*Kv.Key), E);
 				}
 			}
 		}
@@ -1195,14 +1195,14 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 			FString CtlMode;
 			if ((*ArtObj)->TryGetStringField(TEXT("control_mode"), CtlMode))
 			{
-				Cmd->Request.PerArticulationControlMode.Add(Pair.Key, CtlMode);
+				Cmd->Request.PerArticulationControlMode.Add(FString(*Pair.Key), CtlMode);
 			}
 
 			const TArray<TSharedPtr<FJsonValue>>* CtrlList = nullptr;
 			if ((*ArtObj)->TryGetArrayField(TEXT("ctrl"), CtrlList) && CtrlList)
 			{
 				// Positional ctrl array: indexed in articulation actuator order.
-				if (AMjArticulation* Art = Cast<AMjArticulation>(Mgr->GetArticulation(Pair.Key)))
+				if (AMjArticulation* Art = Cast<AMjArticulation>(Mgr->GetArticulation(FString(*Pair.Key))))
 				{
 					TArray<UMjActuator*> Acts = Art->GetActuators();
 					for (int32 i = 0; i < CtrlList->Num() && i < Acts.Num(); ++i)
@@ -1214,7 +1214,7 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 						FString Prefix = Art->GetName() + TEXT("_");
 						if (LocalName.StartsWith(Prefix))
 							LocalName = LocalName.Mid(Prefix.Len());
-						Cmd->Request.PerArticulationCtrl.FindOrAdd(Pair.Key).Add(
+						Cmd->Request.PerArticulationCtrl.FindOrAdd(FString(*Pair.Key)).Add(
 							{LocalName, (float)(*CtrlList)[i]->AsNumber()});
 					}
 				}
@@ -1226,7 +1226,7 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 			{
 				for (auto& KV : (*CtrlMap)->Values)
 				{
-					Cmd->Request.PerArticulationCtrl.FindOrAdd(Pair.Key).Add(
+					Cmd->Request.PerArticulationCtrl.FindOrAdd(FString(*Pair.Key)).Add(
 						{KV.Key, (float)KV.Value->AsNumber()});
 				}
 			}
@@ -1235,13 +1235,13 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleStep(const TSharedPtr<FJsonOb
 			const TSharedPtr<FJsonObject>* XfrcMap = nullptr;
 			if ((*ArtObj)->TryGetObjectField(TEXT("xfrc_applied"), XfrcMap) && XfrcMap && XfrcMap->IsValid())
 			{
-				TMap<FString, TArray<double>>& BodyMap = Cmd->Request.PerArticulationXfrc.FindOrAdd(Pair.Key);
+				TMap<FString, TArray<double>>& BodyMap = Cmd->Request.PerArticulationXfrc.FindOrAdd(FString(*Pair.Key));
 				for (auto& KV : (*XfrcMap)->Values)
 				{
 					const TArray<TSharedPtr<FJsonValue>>* Arr = nullptr;
 					if (KV.Value->TryGetArray(Arr) && Arr && Arr->Num() == 6)
 					{
-						TArray<double>& Six = BodyMap.FindOrAdd(KV.Key);
+						TArray<double>& Six = BodyMap.FindOrAdd(FString(*KV.Key));
 						Six.SetNum(6);
 						for (int i = 0; i < 6; ++i)
 							Six[i] = (*Arr)[i]->AsNumber();
@@ -1827,7 +1827,7 @@ TSharedPtr<FJsonObject> FURLabRpcDispatcher::HandleReset(const TSharedPtr<FJsonO
 		{
 			for (auto& APair : (*PerArt)->Values)
 			{
-				AMjArticulation* Art = Mgr->GetArticulation(APair.Key);
+				AMjArticulation* Art = Mgr->GetArticulation(FString(*APair.Key));
 				if (!Art)
 					continue;
 				const TSharedPtr<FJsonObject>* QObj = nullptr;
-- 
