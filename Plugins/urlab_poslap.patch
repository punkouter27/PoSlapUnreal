@@ -121,16 +121,26 @@ public class URLab : ModuleRules
 				"pthread", "dl", "rt"
 			});
 		}
+		else if (Target.Platform == UnrealTargetPlatform.Android)
+		{
+			PublicSystemLibraries.AddRange(new string[]
+			{
+				"log", "c", "m", "dl"
+			});
+		}
 
 		// Don't define _WIN32 on Linux: `#if defined _WIN32` is true even
