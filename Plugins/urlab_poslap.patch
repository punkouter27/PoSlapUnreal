+
+static inline void* zmq_ctx_new(void) { return nullptr; }
+static inline int zmq_ctx_term(void*) { return 0; }
+static inline void* zmq_socket(void*, int) { return nullptr; }
+static inline int zmq_close(void*) { return 0; }
